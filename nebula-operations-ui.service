[Unit]
Description=nebula-operations-ui — Angular dev server (operations/kanban view, port 4300)
Documentation=https://github.com/markpippins/nebula-operations-ui
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/codex/dev/nexus/angular/nebula-operations-ui
Environment=NODE_ENV=development
Environment=PORT=4300
ExecStart=/home/codex/.nvm/versions/node/v24.15.0/bin/npm start
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target